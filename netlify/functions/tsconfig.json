{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["../../src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["**/*.mts", "../../src/types/**/*.ts", "../../src/services/auction/**/*.ts"]
}
