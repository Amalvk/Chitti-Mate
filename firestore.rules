rules_version = '2';

// MVP rules: authentication is not implemented yet, so every viewer is
// currently treated as a trusted admin. When auth ships, replace
// `allow read, write: if true;` below with checks against a `role` custom
// claim (admin / member / public viewer) — the data model and app code are
// already structured around that distinction (see src/context and the
// admin vs public route trees).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
