VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: point the app at a local Firestore emulator instead of the live project.
VITE_USE_FIRESTORE_EMULATOR=false

# Server-side only (netlify/functions/run-due-lots.mts) — never VITE_-prefixed,
# never sent to the client. A Firebase service account key JSON, base64-encoded
# to one line. Set the real value in Netlify's site environment variables (or
# here in .env.local for `netlify dev`), never commit it. See README.md.
FIREBASE_SERVICE_ACCOUNT=
